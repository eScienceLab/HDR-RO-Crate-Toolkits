new file mode 100644
index 0000000..32e662a
--- /dev/null
+++ b/ServiceStack/compose-manifests/rocrate/validator.yml
@@ -0,0 +1,39 @@
+services:
+
+  # ------ RO-Crate Validator ------
+  # ------------------------------------------
+
+  flask:
+    image: "ghcr.io/esciencelab/cratey-validator-fivesafes-profile:v1.1.1"
+    container_name: ROCValidAPI
+    ports:
+      - "5001:5000"
+    environment:
+      - FLASK_APP=cratey.py
+      - FLASK_ENV=development
+      - CELERY_BROKER_URL=redis://redis:6379/0
+      - CELERY_RESULT_BACKEND=redis://redis:6379/0
+    depends_on:
+      - redis
+    networks:
+      - sub-net
+
+  celery_worker:
+    image: "ghcr.io/esciencelab/cratey-validator-fivesafes-profile:v1.1.1"
+    container_name: ROCValidWorker
+    command: celery -A app.celery_worker.celery worker --loglevel=info -E
+    environment:
+      - CELERY_BROKER_URL=redis://redis:6379/0
+      - CELERY_RESULT_BACKEND=redis://redis:6379/0
+    depends_on:
+      - redis
+    networks:
+      - sub-net
+
+
+  redis:
+    image: "redis:alpine"
+    ports:
+      - "6379:6379"
+    networks:
+      - sub-net
